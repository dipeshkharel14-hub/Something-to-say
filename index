<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>🪷 अनुराग — A Devotion | Crafted for You</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Cinzel+Decorative:wght@400;700&family=Dancing+Script:wght@500;700&family=Tiro+Devanagari+Sanskrit&display=swap" rel="stylesheet">

<!-- Three.js & OrbitControls for 3D Lotus Pond Scene -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<style>
/* ═══════════════════════════════════════════════════════════
   ✦ WELCOME, DIPESH ✦
   Masterpiece Interactive Romantic Experience
   Theme: Lotus Pond & Krishna-Dusk Aesthetics
   ═══════════════════════════════════════════════════════════ */

:root {
  --night:        #170b38;
  --night-deep:   #0a0420;
  --peacock:      #12867c;
  --peacock-deep: #0a4f49;
  --gold:         #e3b23c;
  --gold-soft:    #f6dfa0;
  --lotus:        #ff6f9c;
  --lotus-deep:   #dd3f74;
  --ivory:        #fdf4e6;

  --font-eyebrow: 'Cinzel Decorative', cursive;
  --font-body:    'Cormorant Garamond', serif;
  --font-name:    'Dancing Script', cursive;
  --font-dev:     'Tiro Devanagari Sanskrit', serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 20% 0%, rgba(18,134,124,0.22) 0%, transparent 45%),
    radial-gradient(ellipse at 85% 15%, rgba(227,178,60,0.10) 0%, transparent 40%),
    radial-gradient(ellipse at 50% 100%, rgba(255,111,156,0.10) 0%, transparent 50%),
    linear-gradient(180deg, var(--night-deep) 0%, var(--night) 40%, #200f45 70%, var(--night-deep) 100%);
  font-family: var(--font-body);
  color: var(--ivory);
  overflow-x: hidden;
  position: relative;
}

/* ── CINEMATIC LOADER ── */
#loader {
  position: fixed;
  inset: 0;
  background: var(--night-deep);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 1s ease, visibility 1s ease;
}
#loader.fade-out { opacity: 0; visibility: hidden; }
.loader-lotus { font-size: 64px; animation: pulseLotus 2s ease-in-out infinite; margin-bottom: 16px; }
@keyframes pulseLotus { 0%,100% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(255,111,156,0.4)); } 50% { transform: scale(1.15); filter: drop-shadow(0 0 35px rgba(227,178,60,0.8)); } }
.loader-text { font-family: var(--font-eyebrow); font-size: 13px; letter-spacing: 3px; color: var(--gold-soft); margin-bottom: 20px; }
.loader-bar-track { width: 220px; height: 4px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
.loader-bar-fill { width: 0%; height: 100%; background: linear-gradient(90deg, var(--peacock), var(--gold), var(--lotus)); transition: width 0.3s ease; }

/* ── AMBIENT PETALS + FIREFLIES ── */
.petal {
  position: fixed;
  top: -8vh;
  font-size: 16px;
  pointer-events: none;
  z-index: 5;
  animation: petalFall linear infinite;
  opacity: 0;
}
@keyframes petalFall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
  8%   { opacity: 0.85; }
  92%  { opacity: 0.55; }
  100% { transform: translateY(112vh) rotate(540deg); opacity: 0; }
}

.firefly {
  position: fixed;
  width: 4px;
  height: 4px;
  background: var(--gold-soft);
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 0 8px var(--gold);
  z-index: 4;
  animation: flyAround 8s ease-in-out infinite alternate;
}
@keyframes flyAround {
  0% { transform: translate(0, 0); opacity: 0.2; }
  50% { opacity: 1; }
  100% { transform: translate(calc(100vw * var(--tx, 0.5)), calc(100vh * var(--ty, -0.5))); opacity: 0.1; }
}

/* ── KRISHNA PEACOCK FEATHERS ── */
.corner-feather {
  position: fixed;
  width: 120px;
  height: 220px;
  opacity: 0.2;
  pointer-events: auto;
  cursor: pointer;
  z-index: 10;
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.corner-feather:hover { opacity: 0.5; transform: scale(1.05); }
.corner-feather.tl { top: -30px; left: -30px; transform: rotate(18deg); }
.corner-feather.br { bottom: -30px; right: -30px; transform: rotate(198deg); }

/* ── STAGES ── */
.stage {
  position: relative;
  z-index: 10;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90px 22px;
  transition: filter 0.6s ease, opacity 0.6s ease, height 0.6s ease;
}
.stage.locked {
  filter: blur(14px);
  opacity: 0.15;
  pointer-events: none;
  height: 0;
  min-height: 0;
  overflow: hidden;
  padding: 0;
}
.stage.unlocked { animation: stageIn 1.1s cubic-bezier(0.19,1,0.22,1) both; }
@keyframes stageIn { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

.eyebrow {
  font-family: var(--font-eyebrow);
  font-size: 11px;
  letter-spacing: 4px;
  color: var(--gold-soft);
  text-transform: uppercase;
  opacity: 0.85;
  text-align: center;
  margin-bottom: 14px;
}

.dev {
  font-family: var(--font-dev);
  color: var(--lotus);
}

.section-title {
  font-family: var(--font-eyebrow);
  font-size: 20px;
  letter-spacing: 1px;
  color: var(--ivory);
  text-align: center;
  margin-bottom: 6px;
}
.section-sub {
  font-style: italic;
  font-size: 15.5px;
  color: rgba(253,244,230,0.6);
  text-align: center;
  max-width: 360px;
  margin-bottom: 32px;
  line-height: 1.6;
}/* ── CARDS & BUTTONS ── */
.card {
  width: 100%;
  max-width: 430px;
  background: linear-gradient(155deg, rgba(255,244,230,0.07) 0%, rgba(255,255,255,0.03) 100%);
  border: 1px solid rgba(227,178,60,0.22);
  border-radius: 30px;
  padding: 44px 30px 36px;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 0 1px rgba(18,134,124,0.15), 0 30px 80px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.08);
  text-align: center;
  animation: cardRise 1.3s cubic-bezier(0.19,1,0.22,1) both;
}
@keyframes cardRise { from { transform: translateY(50px) scale(0.94); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }

.bud { font-size: 44px; margin-bottom: 6px; animation: budBreathe 3.2s ease-in-out infinite; }
@keyframes budBreathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }

.name-display {
  font-family: var(--font-name);
  font-size: 40px;
  color: var(--lotus);
  text-shadow: 0 0 30px rgba(255,111,156,0.35);
  margin: 6px 0 18px;
  line-height: 1.1;
}

.question {
  font-style: italic;
  font-size: 18.5px;
  line-height: 1.75;
  color: rgba(253,244,230,0.9);
  padding: 0 6px;
  margin-bottom: 6px;
}
.question span { color: var(--gold-soft); font-weight: 600; font-style: normal; }

.btn-group { display: flex; flex-direction: column; gap: 10px; width: 100%; margin-top: 22px; }
.btn {
  width: 100%;
  padding: 14px 20px;
  border-radius: 50px;
  border: none;
  font-family: var(--font-body);
  font-size: 17px;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
  position: relative;
}
.btn:hover { transform: translateY(-2px) scale(1.02); }
.btn:active { transform: scale(0.97); }

.btn-yes {
  background: linear-gradient(135deg, var(--lotus) 0%, var(--lotus-deep) 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8px 30px rgba(221,63,116,0.45);
}
.btn-maybe {
  background: rgba(227,178,60,0.1);
  color: var(--gold-soft);
  border: 1px solid rgba(227,178,60,0.3);
}
.btn-no {
  background: rgba(255,255,255,0.04);
  color: rgba(253,244,230,0.5);
  border: 1px solid rgba(255,255,255,0.08);
  font-size: 14px;
  display: inline-block;
  width: auto;
  align-self: center;
  padding: 10px 22px;
}

/* ── STAGE 2: FIVE PETALS ── */
.loyalty-meter { width: 100%; max-width: 320px; margin-bottom: 30px; }
.loyalty-label {
  display: flex; justify-content: space-between;
  font-family: var(--font-eyebrow); font-size: 9px;
  letter-spacing: 2px; color: var(--gold-soft); margin-bottom: 8px; opacity: 0.8;
}
.loyalty-track { height: 8px; border-radius: 10px; background: rgba(255,255,255,0.08); overflow: hidden; border: 1px solid rgba(227,178,60,0.25); }
.loyalty-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--peacock), var(--gold), var(--lotus)); transition: width 0.7s cubic-bezier(0.34,1.56,0.64,1); }

.lotus-game { position: relative; width: 280px; height: 280px; margin-bottom: 20px; }
.lotus-center {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 64px; filter: drop-shadow(0 0 30px rgba(255,111,156,0.3)); transition: transform 0.6s ease;
}
.lotus-center.bloomed { transform: scale(1.25); filter: drop-shadow(0 0 60px rgba(255,111,156,0.7)); }

.petal-btn {
  position: absolute; width: 56px; height: 56px; border-radius: 50%;
  border: 1px solid rgba(227,178,60,0.35);
  background: radial-gradient(circle at 35% 30%, rgba(255,111,156,0.22), rgba(18,134,124,0.12));
  color: var(--ivory); font-size: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.35s ease;
  box-shadow: 0 0 20px rgba(0,0,0,0.3);
}
.petal-btn:hover:not(.done) { transform: scale(1.14); }
.petal-btn.done { opacity: 0.35; cursor: default; transform: scale(0.85); }
.petal-btn.p0 { top: 4px; left: 112px; }
.petal-btn.p1 { top: 80px; left: 210px; }
.petal-btn.p2 { top: 200px; left: 172px; }
.petal-btn.p3 { top: 200px; left: 48px; }
.petal-btn.p4 { top: 80px; left: 10px; }

.continue-wrap { min-height: 50px; display: flex; align-items: center; justify-content: center; margin-top: 10px; }
.btn-continue {
  display: none; padding: 12px 30px; border-radius: 50px;
  border: 1px solid rgba(227,178,60,0.5);
  background: linear-gradient(135deg, var(--gold), #c98f22);
  color: #241200; font-family: var(--font-body); font-weight: 600; font-size: 16px; cursor: pointer;
  box-shadow: 0 8px 26px rgba(227,178,60,0.35); animation: fadeUp 0.9s both;
}

/* Modals for word reveal & Beautiful Waiting Overlay */
#wordOverlay, #maybeModal {
  position: fixed; inset: 0; z-index: 3000; display: none; align-items: center; justify-content: center;
  background: rgba(6,2,20,0.88); backdrop-filter: blur(12px); padding: 24px;
}
.word-card {
  width: 100%; max-width: 380px; background: linear-gradient(155deg, rgba(255,244,230,0.09), rgba(18,134,124,0.08));
  border: 1px solid rgba(227,178,60,0.35); border-radius: 26px; padding: 38px 28px; text-align: center;
  box-shadow: 0 30px 80px rgba(0,0,0,0.65), 0 0 40px rgba(255,111,156,0.15); animation: wordIn 0.5s cubic-bezier(0.19,1,0.22,1) both;
}
@keyframes wordIn { from { opacity: 0; transform: scale(0.85) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
.word-dev { font-family: var(--font-dev); font-size: 42px; color: var(--lotus); margin-bottom: 4px; }
.word-translit { font-family: var(--font-eyebrow); font-size: 11px; letter-spacing: 3px; color: var(--gold-soft); text-transform: uppercase; margin-bottom: 12px; }
.word-meaning { font-size: 19px; font-style: italic; color: var(--ivory); margin-bottom: 10px; }
.word-desc { font-size: 14.5px; color: rgba(253,244,230,0.68); line-height: 1.6; margin-bottom: 16px; }
.word-promise { font-size: 15px; color: var(--gold-soft); font-style: italic; border-top: 1px solid rgba(227,178,60,0.2); padding-top: 14px; margin-bottom: 20px; }
.word-close { padding: 12px 28px; border-radius: 50px; border: 1px solid rgba(255,111,156,0.5); background: linear-gradient(135deg, rgba(255,111,156,0.25), rgba(221,63,116,0.35)); color: #ffffff; font-family: var(--font-body); font-size: 16px; cursor: pointer; transition: transform 0.2s ease; }
.word-close:hover { transform: scale(1.05); }/* ── STAGE 3D LOTUS POND (SACRED LOTUS 360-DEGREE PROPOSAL) ── */
#stage-3d-lotus {
  padding: 0;
  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background-color: #02060d;
}

#webgl-container {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.vignette {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  background: radial-gradient(circle at center, transparent 48%, rgba(2, 6, 13, 0.45) 78%, rgba(1, 3, 7, 0.92) 100%);
}

.lotus-3d-overlay {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  pointer-events: auto;
  text-align: center;
  width: 90%;
  max-width: 480px;
}

.lotus-3d-hint {
  font-family: var(--font-eyebrow);
  font-size: 12px;
  letter-spacing: 2.5px;
  color: var(--gold-soft);
  text-shadow: 0 2px 10px rgba(0,0,0,0.9);
  background: rgba(10, 4, 32, 0.55);
  padding: 8px 18px;
  border-radius: 30px;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(227,178,60,0.3);
}

.btn-3d-continue {
  padding: 14px 36px;
  border-radius: 50px;
  border: 1px solid rgba(255,111,156,0.6);
  background: linear-gradient(135deg, var(--lotus) 0%, var(--lotus-deep) 100%);
  color: #ffffff;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 17px;
  letter-spacing: 1px;
  cursor: pointer;
  box-shadow: 0 10px 32px rgba(221,63,116,0.6);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.btn-3d-continue:hover {
  transform: scale(1.05);
  box-shadow: 0 12px 40px rgba(255,111,156,0.8);
}

/* ── STAGE 4: MINI GAMES (Flute Puzzle) ── */
.minigame-container {
  width: 100%; max-width: 420px; background: rgba(255,244,230,0.04);
  border: 1px solid rgba(227,178,60,0.22); border-radius: 22px; padding: 24px; text-align: center; margin-bottom: 20px;
}
.flute-notes { display: flex; justify-content: center; gap: 10px; margin: 16px 0; }
.note-btn {
  width: 50px; height: 50px; border-radius: 50%; border: 1px solid rgba(227,178,60,0.4);
  background: rgba(18,134,124,0.2); color: var(--gold-soft); font-family: var(--font-eyebrow); font-size: 14px; cursor: pointer;
  transition: all 0.2s ease;
}
.note-btn:hover { background: rgba(18,134,124,0.5); transform: scale(1.08); }
.note-btn.active { background: var(--lotus); color: #fff; border-color: var(--lotus); }

/* ── STAGE 5: GLOSSARY ── */
.glossary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; width: 100%; max-width: 420px; }
.gloss-card { background: rgba(255,244,230,0.05); border: 1px solid rgba(227,178,60,0.2); border-radius: 18px; padding: 18px 10px; text-align: center; }
.gloss-dev { font-family: var(--font-dev); font-size: 26px; color: var(--lotus); margin-bottom: 4px; }
.gloss-translit { font-family: var(--font-eyebrow); font-size: 8px; letter-spacing: 1.5px; color: var(--gold-soft); text-transform: uppercase; margin-bottom: 6px; }
.gloss-meaning { font-size: 13.5px; font-style: italic; color: rgba(253,244,230,0.75); }

/* ── STAGE 6: GALLERY & VIDEO ── */
.gallery-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; width: 100%; max-width: 440px; margin-bottom: 26px; }
.gallery-slot {
  aspect-ratio: 3/4; border-radius: 18px; overflow: hidden; border: 1px solid rgba(227,178,60,0.22);
  background: rgba(255,244,230,0.04); display: flex; align-items: center; justify-content: center; position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.gallery-slot:hover { transform: scale(1.03); box-shadow: 0 0 30px rgba(255,111,156,0.3); }
.gallery-slot img { width: 100%; height: 100%; object-fit: cover; display: block; }
.slot-placeholder { display: flex; flex-direction: column; align-items: center; gap: 6px; color: rgba(253,244,230,0.35); font-style: italic; font-size: 11.5px; text-align: center; padding: 14px; }
.slot-num { font-family: var(--font-eyebrow); font-size: 9px; color: rgba(227,178,60,0.4); margin-bottom: 2px; }

.video-slot {
  width: 100%; max-width: 420px; aspect-ratio: 16/10; border-radius: 20px; overflow: hidden;
  border: 1px solid rgba(227,178,60,0.22); background: rgba(255,244,230,0.04); display: flex; align-items: center; justify-content: center; position: relative;
}
.video-slot video { width: 100%; height: 100%; object-fit: cover; display: none; }
.video-slot.has-video video { display: block; }
.video-slot.has-video .slot-placeholder { display: none; }

/* ── STAGE 7: SANSKRIT VERSES ── */
.verse-box {
  background: linear-gradient(155deg, rgba(255,244,230,0.06), rgba(18,134,124,0.06));
  border: 1px solid rgba(227,178,60,0.25); border-radius: 22px; padding: 28px 24px; max-width: 420px; text-align: center; margin-bottom: 18px;
}
.verse-sanskrit { font-family: var(--font-dev); font-size: 20px; color: var(--lotus); line-height: 1.8; margin-bottom: 10px; }
.verse-translit { font-family: var(--font-eyebrow); font-size: 11px; letter-spacing: 2px; color: var(--gold-soft); margin-bottom: 10px; font-style: italic; }
.verse-trans { font-size: 15px; font-style: italic; color: rgba(253,244,230,0.85); line-height: 1.6; }

/* ── STAGE 8: UNCONDITIONAL LOVE POEM ── */
.poem-box {
  background: linear-gradient(155deg, rgba(255,244,230,0.06), rgba(18,134,124,0.06));
  border: 1px solid rgba(227,178,60,0.3); border-radius: 24px; padding: 36px 28px; max-width: 440px; text-align: center;
}
.poem-stanza { margin-bottom: 24px; }
.poem-stanza:last-child { margin-bottom: 0; }
.poem-sanskrit { font-family: var(--font-dev); font-size: 19px; color: var(--lotus); line-height: 1.8; margin-bottom: 4px; }
.poem-translit { font-family: var(--font-eyebrow); font-size: 10px; letter-spacing: 2px; color: var(--gold-soft); margin-bottom: 6px; }
.poem-trans { font-style: italic; font-size: 16px; color: rgba(253,244,230,0.9); line-height: 1.6; }
.poem-div { font-size: 13px; color: var(--gold-soft); margin: 16px 0; opacity: 0.6; }

.flute-icon { width: 70px; height: 70px; margin-bottom: 6px; opacity: 0.85; }
.vow-name { font-family: var(--font-name); font-size: 50px; color: var(--lotus); text-shadow: 0 0 40px rgba(255,111,156,0.5); margin-bottom: 6px; }
.vow-text { max-width: 380px; text-align: center; font-style: italic; font-size: 18px; line-height: 1.85; color: rgba(253,244,230,0.9); margin: 18px 0 30px; }
.seal { font-family: var(--font-eyebrow); font-size: 11px; letter-spacing: 3px; color: var(--gold); border: 1px solid rgba(227,178,60,0.4); border-radius: 50px; padding: 10px 26px; margin-bottom: 40px; }
.footer-credit { font-size: 12px; color: rgba(253,244,230,0.3); font-style: italic; text-align: center; letter-spacing: 0.5px; }

/* Floating celebration items */
.float-item { position: fixed; pointer-events: none; animation: floatUp linear both; z-index: 1500; }
@keyframes floatUp { from { transform: translateY(0) rotate(0deg); opacity: 0.9; } to { transform: translateY(-110vh) rotate(360deg); opacity: 0; } }
.fw { position: fixed; width: 5px; height: 5px; border-radius: 50%; pointer-events: none; animation: fwExplode 1.2s ease-out forwards; z-index: 1600; }
@keyframes fwExplode { to { transform: translate(var(--fx), var(--fy)) scale(0); opacity: 0; } }

/* Sound toggle & Audio Visualizer */
#soundControls {
  position: fixed; bottom: 20px; right: 20px; z-index: 4000; display: flex; align-items: center; gap: 8px;
}
#soundToggle {
  width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(227,178,60,0.35);
  background: rgba(10,4,32,0.65); backdrop-filter: blur(10px); color: var(--gold-soft); font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center;
}
.audio-visualizer {
