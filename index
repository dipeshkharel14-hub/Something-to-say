   ✦ THREE.JS 3D SACRED LOTUS POND & PROPOSAL SKY (FROM LOTUS.HTML) ✦
   ═══════════════════════════════════════════════════════════ */
let is3DInitialized = false;
let scene, camera, renderer, controls;
let clock = new THREE.Clock();
let lotusGroup, petals = [], leaves = [];
let waterMaterial, waterMesh;
let ambientParticles, starsMesh;
let skyPanelsGroup;
let swimmingFishes = [], jumpingFish;

let bloomTime = 0;
let camTarget = new THREE.Vector3(0, 0.45, 0);

// --- WATER GLSL SHADER ---
const WaterShader = {
  vertexShader: `
      uniform float uTime;
      varying vec3 vWorldPosition;
      varying vec3 vNormal;
      varying vec2 vUv;

      void main() {
          vUv = uv;
          vec3 pos = position;

          float wave1 = sin(pos.x * 0.14 + pos.z * 0.09 + uTime * 1.0) * 0.05;
          float wave2 = cos(pos.x * 0.16 - pos.z * 0.20 + uTime * 0.75) * 0.035;
          float wave3 = sin(pos.x * 0.35 + pos.z * 0.25 + uTime * 1.2) * 0.012;
          pos.y += wave1 + wave2 + wave3;

          vec4 worldPos = modelMatrix * vec4(pos, 1.0);
          vWorldPosition = worldPos.xyz;

          float dx = cos(pos.x * 0.14 + pos.z * 0.09 + uTime * 1.0) * 0.007;
          float dz = cos(pos.x * 0.16 - pos.z * 0.20 + uTime * 0.75) * -0.007;
          vNormal = normalize(vec3(-dx, 1.0, -dz));

          gl_Position = projectionMatrix * viewMatrix * worldPos;
      }
  `,
  fragmentShader: `
      uniform vec3 uCameraPosition;
      uniform vec3 uLightDir;
      uniform float uTime;

      varying vec3 vWorldPosition;
      varying vec3 vNormal;
      varying vec2 vUv;

      void main() {
          vec3 viewDir = normalize(uCameraPosition - vWorldPosition);
          vec3 normal = normalize(vNormal);

          float fresnel = pow(1.0 - max(dot(viewDir, normal), 0.0), 3.0);

          vec3 deepWater = vec3(0.01, 0.05, 0.10);
          vec3 shallowWater = vec3(0.02, 0.14, 0.20);
          vec3 skyReflection = vec3(0.22, 0.45, 0.70);

          vec3 baseColor = mix(deepWater, shallowWater, fresnel * 0.5 + 0.5);

          vec3 halfDir = normalize(uLightDir + viewDir);
          float spec = pow(max(dot(normal, halfDir), 0.0), 180.0);
          vec3 specular = vec3(1.0, 0.95, 0.88) * spec * 2.6;

          vec3 finalColor = mix(baseColor, skyReflection, fresnel * 0.65) + specular;
          gl_FragColor = vec4(finalColor, 0.88);
      }
  `
};

function getResponsiveCamDistance() {
  const isMobile = window.innerWidth < 768 || window.innerHeight > window.innerWidth;
  return isMobile ? 13.5 : 9.5;
}

function getResponsiveFOV() {
  const isMobile = window.innerWidth < 768 || window.innerHeight > window.innerWidth;
  return isMobile ? 44 : 35;
}

function init3DLotusScene() {
  if (is3DInitialized) {
    on3DWindowResize();
    return;
  }
  is3DInitialized = true;

  const container = document.getElementById('webgl-container');

  scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x02060d, 0.012);

  const initialDist = getResponsiveCamDistance();
  camera = new THREE.PerspectiveCamera(getResponsiveFOV(), container.clientWidth / container.clientHeight, 0.1, 1000);
  camera.position.set(0, 2.2, initialDist);

  renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: "high-performance" });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.3;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  container.appendChild(renderer.domElement);

  controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.04;
  controls.maxPolarAngle = Math.PI / 2 - 0.01;
  controls.minDistance = 4.0;
  controls.maxDistance = 28;
  controls.target.copy(camTarget);

  controls.autoRotate = true;
  controls.autoRotateSpeed = 1.2;

  setupLighting();
  createWater();
  createLotus();
  createLeaves();
  createFishSystem();
  create360RingProposalSky();
  createAmbientMist();

  window.addEventListener('resize', on3DWindowResize);
  animate3D();
}

function setupLighting() {
  const ambient = new THREE.AmbientLight(0x2d4860, 2.2);
  scene.add(ambient);

  const keyLight = new THREE.DirectionalLight(0xfff5e6, 3.4);
  keyLight.position.set(12, 22, 12);
  keyLight.castShadow = true;
  keyLight.shadow.mapSize.width = 2048;
  keyLight.shadow.mapSize.height = 2048;
  keyLight.shadow.bias = -0.0001;
  scene.add(keyLight);

  const flowerGlow = new THREE.PointLight(0xff2a85, 4.5, 12);
  flowerGlow.position.set(0, 0.8, 0);
  scene.add(flowerGlow);

  const rimLight = new THREE.DirectionalLight(0x40a0ff, 2.4);
  rimLight.position.set(-10, 8, -12);
  scene.add(rimLight);
}

function createWater() {
  const geometry = new THREE.PlaneGeometry(120, 120, 140, 140);
  geometry.rotateX(-Math.PI / 2);

  waterMaterial = new THREE.ShaderMaterial({
      vertexShader: WaterShader.vertexShader,
      fragmentShader: WaterShader.fragmentShader,
      uniforms: {
          uTime: { value: 0 },
          uCameraPosition: { value: camera.position },
          uLightDir: { value: new THREE.Vector3(12, 22, 12).normalize() }
      },
      transparent: true
  });

  waterMesh = new THREE.Mesh(geometry, waterMaterial);
  waterMesh.receiveShadow = true;
  scene.add(waterMesh);
}

function createFishMesh() {
  const fishGroup = new THREE.Group();

  const bodyGeom = new THREE.ConeGeometry(0.12, 0.6, 12);
  bodyGeom.rotateX(Math.PI / 2);
  const bodyMat = new THREE.MeshStandardMaterial({
      color: 0xff4500,
      roughness: 0.2,
      metalness: 0.1,
      emissive: 0xaa2200,
      emissiveIntensity: 0.2
  });
  const body = new THREE.Mesh(bodyGeom, bodyMat);
  fishGroup.add(body);

  const tailGeom = new THREE.BufferGeometry();
  const vertices = new Float32Array([
      0, 0, -0.3,
      0, 0.15, -0.55,
      0, -0.15, -0.55
  ]);
  tailGeom.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
  tailGeom.computeVertexNormals();

  const tailMat = new THREE.MeshBasicMaterial({ color: 0xff8833, side: THREE.DoubleSide });
  const tail = new THREE.Mesh(tailGeom, tailMat);
  tail.name = "tail";
  fishGroup.add(tail);

  return fishGroup;
}

function createFishSystem() {
  swimmingFishes = [];

  for (let i = 0; i < CONFIG.fishCount; i++) {
      const fish = createFishMesh();
      const radius = 2.5 + Math.random() * 3.5;
      const angle = (i / CONFIG.fishCount) * Math.PI * 2;
  fish.position.set(Math.cos(angle) * radius, -0.35 - Math.random() * 0.3, Math.sin(angle) * radius);
      fish.scale.set(1.2, 1.2, 1.2);
      scene.add(fish);

      swimmingFishes.push({
          mesh: fish,
          radius: radius,
          angle: angle,
          speed: 0.4 + Math.random() * 0.3,
          wiggleSpeed: 8 + Math.random() * 4,
          depth: fish.position.y
      });
  }

  const jFishMesh = createFishMesh();
  jFishMesh.scale.set(1.4, 1.4, 1.4);
  jFishMesh.visible = false;
  scene.add(jFishMesh);

  jumpingFish = {
      mesh: jFishMesh,
      timer: 0,
      jumpInterval: 4.5,
      isJumping: false,
      jumpProgress: 0,
      startPos: new THREE.Vector3(),
      endPos: new THREE.Vector3()
  };
   } function updateFishes(delta, time) {
  swimmingFishes.forEach(f => {
      f.angle += delta * f.speed * 0.3;
      f.mesh.position.x = Math.cos(f.angle) * f.radius;
      f.mesh.position.z = Math.sin(f.angle) * f.radius;
      f.mesh.rotation.y = -f.angle + Math.PI / 2;

      const tail = f.mesh.getObjectByName("tail");
      if (tail) {
          tail.rotation.y = Math.sin(time * f.wiggleSpeed) * 0.35;
      }
  });

  if (!jumpingFish.isJumping) {
      jumpingFish.timer += delta;
      if (jumpingFish.timer >= jumpingFish.jumpInterval) {
          jumpingFish.timer = 0;
          jumpingFish.isJumping = true;
          jumpingFish.jumpProgress = 0;
          jumpingFish.mesh.visible = true;

          const angle = Math.random() * Math.PI * 2;
          const r1 = 3.0 + Math.random() * 1.5;
          const r2 = 2.0 + Math.random() * 1.5;

          jumpingFish.startPos.set(Math.cos(angle) * r1, -0.2, Math.sin(angle) * r1);
          jumpingFish.endPos.set(Math.cos(angle + 1.2) * r2, -0.2, Math.sin(angle + 1.2) * r2);
      }
  } else {
      jumpingFish.jumpProgress += delta * 1.1;
      const p = Math.min(jumpingFish.jumpProgress, 1.0);

      jumpingFish.mesh.position.lerpVectors(jumpingFish.startPos, jumpingFish.endPos, p);
      jumpingFish.mesh.position.y = Math.sin(p * Math.PI) * 1.8 - 0.2;

      const nextPoint = new THREE.Vector3().lerpVectors(jumpingFish.startPos, jumpingFish.endPos, Math.min(p + 0.05, 1.0));
      nextPoint.y = Math.sin(Math.min(p + 0.05, 1.0) * Math.PI) * 1.8 - 0.2;
      jumpingFish.mesh.lookAt(nextPoint);

      const tail = jumpingFish.mesh.getObjectByName("tail");
      if (tail) tail.rotation.y = Math.sin(time * 18.0) * 0.4;

      if (p >= 1.0) {
          jumpingFish.isJumping = false;
          jumpingFish.mesh.visible = false;
      }
  }
}

function create360RingProposalSky() {
  const starCount = 1200;
  const starGeom = new THREE.BufferGeometry();
  const starPositions = new Float32Array(starCount * 3);

  for (let i = 0; i < starCount; i++) {
      const r = 45 + Math.random() * 45;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.random() * (Math.PI / 2.2);

      starPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      starPositions[i * 3 + 1] = r * Math.cos(phi) + 2;
      starPositions[i * 3 + 2] = r * Math.sin(phi) * Math.sin(theta);
  }
  starGeom.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));

  const starMat = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.25,
      transparent: true,
      opacity: 0.85
  });
  starsMesh = new THREE.Points(starGeom, starMat);
  scene.add(starsMesh);

  skyPanelsGroup = new THREE.Group();
  scene.add(skyPanelsGroup);

  const panelRadius = 20.0;
  const totalPanels = 8;

  for (let i = 0; i < totalPanels; i++) {
      const angle = (i / totalPanels) * Math.PI * 2;
      const textData = CONFIG.proposalTexts[i % CONFIG.proposalTexts.length];

      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 300;
      const ctx = canvas.getContext('2d');

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      ctx.font = '300 36px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.shadowColor = 'rgba(255, 100, 190, 0.95)';
      ctx.shadowBlur = 18;
      ctx.fillStyle = '#ffe6f2';
      ctx.fillText(textData.line1, canvas.width / 2, 70);

      ctx.font = '400 42px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.shadowColor = 'rgba(255, 150, 220, 0.95)';
      ctx.shadowBlur = 22;

      const gradPink = ctx.createLinearGradient(0, 0, canvas.width, 0);
      gradPink.addColorStop(0.1, '#ffd1dc');
      gradPink.addColorStop(0.5, '#ffffff');
      gradPink.addColorStop(0.9, '#ffb3e6');
      ctx.fillStyle = gradPink;
      ctx.fillText(textData.line2, canvas.width / 2, 150);

      ctx.font = '300 32px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.shadowColor = 'rgba(255, 80, 180, 0.85)';
      ctx.shadowBlur = 15;
      ctx.fillStyle = '#ff99dd';
      ctx.fillText(textData.sub, canvas.width / 2, 230);

      const texture = new THREE.CanvasTexture(canvas);
